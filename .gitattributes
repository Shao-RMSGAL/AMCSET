# Automatically detect text files
* text=auto

# C/C++ source files: store LF in the repository
*.h     text eol=lf
*.cpp   text eol=lf

# CMake
*.cmake text eol=lf
CMakeLists.txt text eol=lf

# Shell/python scripts
*.sh text eol=lf
*.py text eol=lf


# Windows-specific scripts
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf