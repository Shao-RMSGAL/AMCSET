{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "AMCSET: Bombardment Test (F5)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/Release/common-test",
            "args": [
                "--gtest_filter=CommonTest.simulation_and_settings_test",
                "--v=2",
                "--logtostderr"
            ],
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "AMCSET: Build common-test",
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "stopAtEntry": false,
            "externalConsole": false
        }
    ]
}