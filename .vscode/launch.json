{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "AMCSET: Run (Ctrl+F5)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/Release/amcset-gui",
            "args": [
                "--gui=true",
                "-v=0"
