            "miDebuggerPath": "/usr/bin/gdb",
            "stopAtEntry": false,
            "externalConsole": false
        },
        {
            "name": "AMCSET: Debug",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/Release/amcset-gui",
            "args": [
                "--gui=true",
                "-v=0"
            ],
