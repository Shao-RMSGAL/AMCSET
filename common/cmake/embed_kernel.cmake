# Writes OUTPUT: a C++ file defining `const std::string &amcset::compute::FUNCTION()`
# with the bytes of INPUT (the GPU kernel's text, compiled at run time by
# OpenCL, hiprtc or NVRTC; or a code object compiled by hipcc). An INPUT that
# is empty or missing gives an empty string.
# Usage: cmake -DINPUT=... -DOUTPUT=... [-DFUNCTION=kernel_source] -P embed_kernel.cmake
if(NOT FUNCTION)
    set(FUNCTION kernel_source)
endif()
set(hex "")
if(INPUT AND EXISTS "${INPUT}")
    file(READ "${INPUT}" hex HEX)
endif()
string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
string(REGEX REPLACE "(0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,)" "\\1\n" bytes "${bytes}")
file(WRITE "${OUTPUT}.tmp"
"// Generated by common/cmake/embed_kernel.cmake from ${INPUT}. Do not edit.
#include <string>
namespace amcset {
namespace compute {
namespace {
const unsigned char ${FUNCTION}_bytes[] = {
${bytes}0x00};
} // namespace
const std::string &${FUNCTION}() {
  static const std::string s(reinterpret_cast<const char *>(${FUNCTION}_bytes), sizeof(${FUNCTION}_bytes) - 1);
  return s;
}
} // namespace compute
} // namespace amcset
")
file(COPY_FILE "${OUTPUT}.tmp" "${OUTPUT}" ONLY_IF_DIFFERENT)
file(REMOVE "${OUTPUT}.tmp")
