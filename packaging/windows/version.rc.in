// Windows resources of @RC_NAME@.exe (configured by packaging/windows/resources.cmake):
// the version information Explorer, installers and SmartScreen show, and the icon.

#include <winver.h>

@RC_ICON_LINE@

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @amcset_VERSION_MAJOR@,@amcset_VERSION_MINOR@,@amcset_VERSION_PATCH@,0
 PRODUCTVERSION @amcset_VERSION_MAJOR@,@amcset_VERSION_MINOR@,@amcset_VERSION_PATCH@,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "Texas A&M University"
      VALUE "FileDescription", "@RC_DESCRIPTION@"
      VALUE "FileVersion", "@amcset_VERSION@"
      VALUE "InternalName", "@RC_NAME@"
      VALUE "LegalCopyright", "Copyright 2025 Texas A&M University. GPL-3.0-or-later."
      VALUE "OriginalFilename", "@RC_NAME@.exe"
      VALUE "ProductName", "AMCSET"
      VALUE "ProductVersion", "@amcset_VERSION@"
      VALUE "Comments", "@PROJECT_HOMEPAGE_URL@"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
